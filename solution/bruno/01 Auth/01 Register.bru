meta {
  name: 01 Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

tests {
  test("creates an unverified user", function () {
    expect(res.status).to.equal(201);
    expect(res.body.is_verified).to.equal(false);
  });
}
