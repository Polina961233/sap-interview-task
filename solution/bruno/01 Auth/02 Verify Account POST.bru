meta {
  name: 02 Verify Account POST
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{verificationToken}}"
  }
}

tests {
  test("verifies the account", function () {
    expect(res.status).to.equal(200);
    expect(res.body.user.is_verified).to.equal(true);
  });
}
