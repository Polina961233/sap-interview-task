meta {
  name: 04 Current User
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

tests {
  test("returns authenticated user", function () {
    expect(res.status).to.equal(200);
    expect(res.body.user.username).to.equal("{{username}}");
  });
}
