meta {
  name: 05 Weak Password - Known Defect
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "weak_password_manual_test",
    "password": "1"
  }
}

docs {
  Expected secure behavior: HTTP 400.
  Current behavior (BUG-011): HTTP 201 because the password schema only requires one character.
  Change the username before repeating the request.
}
