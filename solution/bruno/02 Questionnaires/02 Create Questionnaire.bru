meta {
  name: 02 Create Questionnaire
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/questionnaires
  body: json
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Bruno Security Questionnaire",
    "questions": [
      {
        "prompt": "What is the minimum password length?",
        "answerType": "number"
      },
      {
        "prompt": "Which password hashing algorithm is used?",
        "answerType": "text",
        "regex": "^(Argon2|bcrypt)$"
      }
    ]
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setVar("questionnaireId", res.body.id);
  }
}

tests {
  test("creates questionnaire", function () {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("string");
  });
}

docs {
  The request stores questionnaireId as a runtime variable.
  Change the title before repeating because titles are unique per owner, case-insensitively.
}
