meta {
  name: 03 Get Questionnaire With Evidence
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/questionnaires/{{questionnaireId}}
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

script:post-response {
  if (res.status === 200 && res.body.questions) {
    if (res.body.questions[0]) bru.setVar("questionId1", res.body.questions[0].id);
    if (res.body.questions[1]) bru.setVar("questionId2", res.body.questions[1].id);
  }
}

tests {
  test("returns questionnaire questions", function () {
    expect(res.status).to.equal(200);
    expect(res.body.questions).to.be.an("array");
  });
}

docs {
  This request also triggers embedding and Qdrant search for each question.
  It stores the first two question IDs as runtime variables for response requests.
}
